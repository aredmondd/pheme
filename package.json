{
  "name": "nba-catchup",
  "version": "1.0.0",
  "scripts": {
    "build": "tsx src/build.tsx && tailwindcss -i src/styles.css -o out/styles.css --minify",
    "typecheck": "tsc",
    "dev": "npm run build && npx --yes serve out",
    "daily": "tsx src/build.tsx --save-state && tailwindcss -i src/styles.css -o out/styles.css --minify"
  },
  "private": true,
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
