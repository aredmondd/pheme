{
  "name": "nba-catchup",
  "version": "1.0.0",
  "scripts": {
    "build": "tsx src/build.tsx && tailwindcss -i src/styles.css -o out/styles.css --minify",
    "typecheck": "tsc",
    "dev": "tsx src/dev.ts",
    "preview": "npm run build && npx --yes serve out",
    "daily": "tailwindcss -i src/styles.css -o out/styles.css --minify && tsx src/build.tsx --save-state --notify",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "preact": "^11.1.1",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  }
}
