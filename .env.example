# Copy to .env on the ThinkPad (deploy.sh never syncs .env).
# Pick a long random topic — anyone who knows it can read your notifications.
NTFY_TOPIC=nba-catchup-change-me-to-something-random
SITE_URL=https://thinkpad.your-tailnet.ts.net/
# Free key from console.groq.com → API Keys. Without it, the page renders without summaries.
GROQ_API_KEY=
# YouTube Data API v3 key (console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key).
# Without it, video sections show as unavailable and highlights fall back to search links.
YOUTUBE_API_KEY=
